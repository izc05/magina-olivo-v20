<?xml version="1.0" encoding="utf-8"?>
<!--
    Android backup is disabled so an account's local database and encrypted session cannot be
    restored independently of the app's own verified synchronization and authorization.
    Android 12+ still runs device-to-device transfer when allowBackup is false, so both the
    cloud backup and the D2D transfer exclude every domain: the Room database, the attachment
    copies, the camera cache and the preferences never leave the phone half-restored.
    Android 11 and lower: allowBackup="false" in the manifest already disables everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
