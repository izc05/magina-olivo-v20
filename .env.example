# V20 local configuration contract.
# Copy only the variables required by the services you run; never commit real secrets.

# Shared / API / worker
DATABASE_URL=postgresql://magina:change-me@127.0.0.1:5432/magina_v20
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# Authentication
# OAuth 2.0 Web Client ID from Google Cloud Console. Not a client secret.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
AUTH_COOKIE_SECURE=false
# Development escape hatch only. Keep false outside controlled local/E2E environments.
ALLOW_DEV_AUTH_HEADERS=false

# Browser/API boundary
# Prefer routing the API on the same public origin as the web in production.
# If web and API use different origins, list only the trusted web origins here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web authenticated mode
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# Never enable this in staging/production. It is only for the static GitHub Pages demo.
NEXT_PUBLIC_PREVIEW_MODE=false

# Weather / external providers
AEMET_API_KEY=replace-me

# S3-compatible private storage shared by documents and radar
S3_ENDPOINT=https://example-account.r2.cloudflarestorage.com
S3_BUCKET=magina-private-documents
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_PREFIX=private-documents
S3_UPLOAD_TTL_SECONDS=900
S3_READ_TTL_SECONDS=600
RADAR_S3_PREFIX=weather/radar

# Worker modules
# Enable one or more comma-separated modules: ocr,radar,notifications.
WORKER_MODULES=ocr
# `test` is deterministic and is rejected when NODE_ENV=production.
# OCR is intentionally not production-ready until a real processor is configured.
OCR_PROCESSOR_MODE=test

# Web Push / VAPID
# The API needs only VAPID_PUBLIC_KEY. The notification worker needs all three values.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# GitHub Pages preview only
GITHUB_PAGES=false
NEXT_PUBLIC_BASE_PATH=
