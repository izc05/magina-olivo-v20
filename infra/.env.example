# Database / domain / pg-boss
DATABASE_URL=postgresql://magina:magina@127.0.0.1:5432/magina_v20
PORT=3001
HOST=0.0.0.0

# S3-compatible document storage (MinIO local or Cloudflare R2 production)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=magina-private-documents
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# Worker
# `test` is allowed only when NODE_ENV is not production.
# A production OCR provider will be selected only after benchmark.
OCR_PROCESSOR_MODE=test
NODE_ENV=development
