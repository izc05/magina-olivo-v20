# Local infrastructure / services
DATABASE_URL=postgresql://magina:magina@127.0.0.1:5432/magina_v20
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Authentication / API boundary
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
AUTH_COOKIE_SECURE=false
ALLOW_DEV_AUTH_HEADERS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Weather
AEMET_API_KEY=replace-me

# S3-compatible storage (MinIO local or Cloudflare R2 production)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=magina-private-documents
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
S3_PREFIX=private-documents
S3_UPLOAD_TTL_SECONDS=900
S3_READ_TTL_SECONDS=600
RADAR_S3_PREFIX=weather/radar

# Worker
# Enable one or more comma-separated modules: ocr,radar,notifications.
WORKER_MODULES=ocr
# `test` is allowed only when NODE_ENV is not production.
# A production OCR processor has not been selected yet.
OCR_PROCESSOR_MODE=test

# Web Push / VAPID
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
