# API service
DATABASE_URL=postgresql://magina:magina@127.0.0.1:5432/magina_v20
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Authentication / browser boundary
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
AUTH_COOKIE_SECURE=false
ALLOW_DEV_AUTH_HEADERS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Weather provider used by API agronomy/weather routes
AEMET_API_KEY=replace-me

# S3-compatible private document storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=magina-private-documents
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
S3_PREFIX=private-documents
S3_UPLOAD_TTL_SECONDS=900
S3_READ_TTL_SECONDS=600

# Public VAPID key only. The private key belongs exclusively to the notification worker.
VAPID_PUBLIC_KEY=
