{
  "name": "@magina/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "market:source-check": "tsx src/market/refresh-cli.ts --source-check",
    "market:refresh:dry-run": "tsx src/market/refresh-cli.ts --dry-run",
    "market:refresh": "tsx src/market/refresh-cli.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@magina/contracts": "workspace:*",
    "@magina/jobs": "workspace:*",
    "@magina/weather": "workspace:*",
    "fastify": "^5.12.3",
    "google-auth-library": "^11.0.2",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "proj4": "^2.19.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.0"
  }
}
