# Worker service
DATABASE_URL=postgresql://magina:magina@127.0.0.1:5432/magina_v20
NODE_ENV=development

# Enable one or more comma-separated modules: ocr,radar,notifications
WORKER_MODULES=ocr

# OCR
# `test` is deterministic and is refused in NODE_ENV=production.
OCR_PROCESSOR_MODE=test

# Weather used by agronomy notification evaluation
AEMET_API_KEY=replace-me

# S3-compatible storage required by the radar module
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=magina-private-documents
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
RADAR_S3_PREFIX=weather/radar

# Web Push / VAPID required by the notifications module.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
