FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .nvmrc ./
COPY scripts/check-runtime-contract.mjs scripts/check-runtime-contract.mjs
COPY apps/web/package.json apps/web/package.json

RUN pnpm install --frozen-lockfile --filter @magina/web...

COPY apps/web apps/web
COPY scripts/check-web-bundle-budget.mjs scripts/check-web-bundle-budget.mjs

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_CLIENT_ID}
ENV NEXT_PUBLIC_PREVIEW_MODE=false
ENV GITHUB_PAGES=false

RUN test -n "$NEXT_PUBLIC_API_URL" \
 && test -n "$NEXT_PUBLIC_GOOGLE_CLIENT_ID" \
 && pnpm --filter @magina/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0

COPY deploy/staging/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/out /usr/share/nginx/html

EXPOSE 8080
