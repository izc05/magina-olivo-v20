FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @magina/web...

COPY apps/web apps/web
COPY scripts/check-web-bundle-budget.mjs scripts/check-web-bundle-budget.mjs

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_CLIENT_ID}
ENV NEXT_PUBLIC_PREVIEW_MODE=false
ENV GITHUB_PAGES=false

RUN test -n "$NEXT_PUBLIC_API_URL" \
  && test -n "$NEXT_PUBLIC_GOOGLE_CLIENT_ID" \
  && pnpm --filter @magina/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY deploy/staging/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/out /usr/share/nginx/html

EXPOSE 8080
