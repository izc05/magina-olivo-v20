FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@10.15.1 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .nvmrc ./
COPY scripts/check-runtime-contract.mjs scripts/check-runtime-contract.mjs
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/jobs/package.json packages/jobs/package.json
COPY packages/weather/package.json packages/weather/package.json

RUN pnpm install --frozen-lockfile --filter @magina/api...

COPY apps/api apps/api
COPY packages/contracts packages/contracts
COPY packages/jobs packages/jobs
COPY packages/weather packages/weather

RUN pnpm --filter @magina/contracts build \
 && pnpm --filter @magina/weather build \
 && pnpm --filter @magina/jobs build \
 && pnpm --filter @magina/api build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app /app

RUN chown -R node:node /app
USER node

EXPOSE 3001
CMD ["node", "apps/api/dist/server.js"]
