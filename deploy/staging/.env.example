# V20 staging — copy to a private .env on the staging host. Never commit real secrets.
NODE_ENV=production

# PostgreSQL/PostGIS
DATABASE_URL=postgresql://magina_staging:CHANGE_ME@postgres:5432/magina_staging
HOST=0.0.0.0
PORT=3001

# Browser/API boundary
CORS_ALLOWED_ORIGINS=https://staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com
NEXT_PUBLIC_PREVIEW_MODE=false

# Authentication
# Current Google ID-token flow requires the same OAuth Web Client ID on API and web.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
AUTH_COOKIE_SECURE=true
ALLOW_DEV_AUTH_HEADERS=false

# Storage (S3-compatible)
S3_ENDPOINT=https://CHANGE_ME
S3_REGION=auto
S3_BUCKET=magina-staging
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_PREFIX=private-documents
S3_UPLOAD_TTL_SECONDS=900
S3_READ_TTL_SECONDS=600
RADAR_S3_PREFIX=weather/radar

# Worker modules
# OCR is intentionally omitted in production until a production processor is configured.
WORKER_MODULES=radar,notifications

# Web Push
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:CHANGE_ME@example.com

# External providers
AEMET_API_KEY=CHANGE_ME
