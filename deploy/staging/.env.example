# V20 staging — copy to a private .env on the staging host. Never commit real secrets.
NODE_ENV=production

# PostgreSQL/PostGIS — POSTGRES_PASSWORD and DATABASE_URL must use the same password.
POSTGRES_USER=magina_staging
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=magina_staging
DATABASE_URL=postgresql://magina_staging:CHANGE_ME_DB_PASSWORD@postgres:5432/magina_staging

# Web/API are bound to host loopback by docker-compose; put HTTPS/Cloudflare/reverse proxy in front.
WEB_PORT=8080
API_PORT=3001
HOST=0.0.0.0
PORT=3001

# Browser/API boundary
CORS_ALLOWED_ORIGINS=https://staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com
NEXT_PUBLIC_PREVIEW_MODE=false
PUBLIC_WEB_ORIGIN=https://staging.example.com

# Authentication — Google ID-token flow uses the same OAuth Web Client ID on API and web.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
AUTH_COOKIE_SECURE=true
ALLOW_DEV_AUTH_HEADERS=false

# Corporate Admin bootstrap — optional after the first super_admin is established.
ADMIN_BOOTSTRAP_EMAILS=

# API runtime hardening
LOG_LEVEL=info
# Set true only when all external API requests arrive through the trusted proxy/tunnel.
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_PRIVATE_MAX=300
RATE_LIMIT_MAX_BUCKETS=10000

# Storage (S3-compatible)
S3_ENDPOINT=https://CHANGE_ME
S3_REGION=auto
S3_BUCKET=magina-staging
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_PREFIX=private-documents
S3_UPLOAD_TTL_SECONDS=900
S3_READ_TTL_SECONDS=600
RADAR_S3_PREFIX=weather/radar

# Worker modules
WORKER_MODULES=ocr,radar,notifications

# OCR — self-hosted Tesseract CLI. The worker image includes Tesseract + Poppler.
OCR_PROVIDER=tesseract
OCR_TESSERACT_LANGUAGES=spa+eng
OCR_MAX_BYTES=26214400
OCR_MAX_PDF_PAGES=12
OCR_TESSERACT_TIMEOUT_MS=120000
OCR_TESSERACT_DPI=250
OCR_TESSERACT_PSM=6
TESSERACT_BIN=tesseract
PDFINFO_BIN=pdfinfo
PDFTOPPM_BIN=pdftoppm

# Web Push
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:CHANGE_ME@example.com

# External providers
AEMET_API_KEY=CHANGE_ME
